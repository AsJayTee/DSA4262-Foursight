# --- data: never commit. This file is load-bearing. ---
data/*
data0/
*.json.gz
*.parquet

# ...except the small test dataset the handout requires us to ship.
# These re-includes MUST come after the *.json.gz rule above, or the rule
# wins and the sample silently never gets committed.
!data/sample/
!data/sample/**

# scratch prediction output
predictions.csv
*.predictions.csv

# --- secrets ---
.env

# --- course materials (public repo; these came from Canvas) ---
*.pdf
handout_*.html

# --- trained models: only the final one is committed, by hand ---
models/*
!models/final/
!models/final/**
# ...but never an out-of-fold score table. Nothing writes one any more
# (docs/decisions/0009), but an old checkout can still have one sitting there,
# and it is ~9 MB of per-site data in a public repo if it gets copied in.
models/final/oof.csv

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# --- tooling ---
wandb/
.DS_Store

# --- evaluation feature cache (rebuildable; see src/m6a/feature_cache.py) ---
.cache/
